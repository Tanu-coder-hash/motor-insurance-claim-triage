# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=motor_insurance

# Python application database connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/motor_insurance

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Application configuration
APP_NAME=Motor Insurance Claim Triage
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Rate limiting and caching
RATE_LIMIT_PER_MIN=30
RUN_CACHE_TTL_S=3600